# Supabase browser/server client
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.invalid
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
NEXT_PUBLIC_ENABLE_FACEBOOK_AUTH=false
NEXT_PUBLIC_MAINTENANCE_MODE=false
MAINTENANCE_MODE=false

# Google OAuth direct web flow.
# Use this when NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true so Google shows the
# Perfect AuPair OAuth app/domain instead of the Supabase project URL.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional SEO/analytics
# Google Search Console verification token from the HTML tag method.
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional funnel analytics, loaded only after optional cookie consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Cloudflare Turnstile. The widget is shown only after suspicious
# request patterns, not for normal login/signup/reset flows.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional consent-gated UX debugging/session tools. Disabled by default even
# when IDs are present. Private message routes, including admin conversation
# moderation, remain excluded and masked.
NEXT_PUBLIC_ENABLE_HEATMAP_TOOLS=false
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_HOTJAR_SITE_ID=
NEXT_PUBLIC_HOTJAR_VERSION=6

# Optional Sentry error monitoring. NEXT_PUBLIC_SENTRY_DSN is safe for the
# browser. SENTRY_AUTH_TOKEN is secret and only needed in Vercel for source maps.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Supabase admin client, server-only
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
ADMIN_NOTIFICATION_EMAIL=admin@example.invalid
MAINTENANCE_BYPASS_SECRET=

# Optional server-side override for DB-backed kill switches.
FEATURE_STORIES_ENABLED=
FEATURE_UPLOADS_ENABLED=
FEATURE_PROFILE_VIDEOS_ENABLED=
FEATURE_MESSAGE_SEND_ENABLED=
FEATURE_MESSAGE_MEDIA_UPLOADS_ENABLED=
FEATURE_ENGAGEMENT_EMAILS_ENABLED=
FEATURE_CLARITY_ENABLED=
FEATURE_HOTJAR_ENABLED=

# Optional HMAC secret for server-side request hashes used by abuse/rate-limit
# tables. If empty, the app falls back to service-role-related secrets.
SECURITY_RATE_LIMIT_HASH_SECRET=
# Leave false on the current Vercel-direct production path. Enable only after
# Cloudflare is deliberately placed in proxy mode in front of Vercel.
TRUST_CLOUDFLARE_PROXY=false

# Optional aliases supported by the app
SUPABASE_URL=
SERVICE_ROLE_KEY=

# Maintenance endpoint protection
# Vercel Cron sends this as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Optional manual cleanup secret aliases
STORY_CLEANUP_SECRET=
MESSAGE_PHOTO_RETENTION_CLEANUP_SECRET=

# Optional cron heartbeat URLs. A *_URL value is pinged on success. START_URL
# and FAILURE_URL are optional if your monitor supports them.
CRON_MONITOR_CLEANUP_EXPIRED_STORIES_URL=
CRON_MONITOR_CLEANUP_EXPIRED_STORIES_START_URL=
CRON_MONITOR_CLEANUP_EXPIRED_STORIES_FAILURE_URL=
CRON_MONITOR_CLEANUP_RETAINED_MESSAGE_PHOTOS_URL=
CRON_MONITOR_DELETE_SCHEDULED_ACCOUNTS_URL=
CRON_MONITOR_ROLL_PROFILE_AVAILABILITY_URL=
CRON_MONITOR_SEND_PROFILE_COMPLETION_REMINDERS_URL=
CRON_MONITOR_SEND_MESSAGE_DIGESTS_URL=

# Optional transactional email for admin notifications
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM="Perfect AuPair <no-reply@example.invalid>"
