# Local-only Supabase values for integration tests.
# Do not put production Supabase values here.
#
# You can get local values with:
# supabase status -o env
# or, on Homebrew installs that expose it:
# supabase-go status -o env

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<local publishable/anon key>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local publishable/anon key>
SUPABASE_SERVICE_ROLE_KEY=<local secret/service_role key>
